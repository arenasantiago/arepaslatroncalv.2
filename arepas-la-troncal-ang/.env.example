# Copia este archivo como .env (NO se versiona) y completa los valores.
# En Vercel/CI se configuran como variables de entorno del proyecto.

# Supabase > Project Settings > API Keys. Solo la clave PUBLICABLE (sb_publishable_...).
# NUNCA pongas aqui la secret key ni la service_role.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX

# WhatsApp que recibe los pedidos: solo digitos, con indicativo (57 = Colombia).
# Si se deja vacio se usa el numero real del negocio. En local usa tu numero de pruebas.
WHATSAPP_PHONE=

# Origen publico del sitio (canonical, Open Graph, sitemap). Sin barra final.
# En Vercel, si se deja vacio, se usa el dominio de produccion del proyecto.
SITE_URL=
